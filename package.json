{
  "name": "trade-terminal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "check-errors": "pnpm lint && pnpm typecheck",
    "build": "pnpm --filter @trade-terminal/web build",
    "start": "pnpm --filter @trade-terminal/server start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
